    "Continuing will launch multiple Illustrator instances." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このまま続行すると、複数の Illustrator が起動する状態になります。"
          }
        }
      }
    },
    "Copies the .ai, .ait, and .eps icons from %@ into Glow Ai, so files associated with Glow Ai also show the latest Illustrator icons." : {
      "comment" : "Preferences: %@ = Illustrator name, e.g. Adobe Illustrator 2026",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の.ai／.ait／.epsのアイコンをGlow Aiに取り込みます。Glow Aiに関連付けたファイルのアイコンをIllustratorの最新アイコンにするためです。"
          }
        }
      }
    },
